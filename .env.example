# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=
HF_TOKEN=
MISTRAL_API_KEY=

# Optional overrides — defaults are set in src/plain_language_ch_verwaltung/config.py
CLAUDE_MODEL=claude-sonnet-5

# Two open-weight models, called via Hugging Face Inference Providers
# (router.huggingface.co) using a single HF_TOKEN — no separate Groq or OpenAI account.
# Both verified (as of 2026-08-22) to be hosted on the "novita" backend, both ungated
# (no license click-through needed). HF's provider catalog rotates — before relying on
# these, spot-check with:
#   curl -s "https://huggingface.co/api/models/<org>/<model>?expand[]=inferenceProviderMapping"
HF_MODEL_QWEN=Qwen/Qwen2.5-72B-Instruct
HF_MODEL_DEEPSEEK=deepseek-ai/DeepSeek-V3

# Third open-weight model, called directly against Mistral's own API (not Hugging Face)
# to use existing Mistral credits. Apache 2.0 licensed - genuinely open-weight, not one
# of Mistral's closed/proprietary models.
MISTRAL_MODEL=ministral-8b-2512

# Which backend Inference Providers routes each Hugging-Face-hosted call to. Pinned
# explicitly (not "auto") so runs don't silently land on Groq or a backend that doesn't
# host a given model.
HF_PROVIDER=novita

# Which model_id (see config.MODELS) acts as the LLM judge. Defaults to the strongest
# open model so Claude — one of the models being compared — isn't grading its own
# output, and judging stays free via Hugging Face.
JUDGE_MODEL_ID=qwen
